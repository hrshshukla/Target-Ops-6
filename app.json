{
  "expo": {
    "name": "Target Ops",
    "slug": "target-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android", "web"],
    "icon": "./assets/images/icon.png",
    "scheme": "target-ops",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1118"
    },
    "android": {
      "package": "com.targetops.internal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A1118"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
