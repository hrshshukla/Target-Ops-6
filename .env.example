# Expo client configuration
# This value is embedded in the Expo bundle because it uses the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL=https://target-ops-6.vercel.app

# Server configuration
# Keep server-only values out of the Expo bundle.
DATABASE_URL="postgresql://neondb_owner:xxxxx"
NODE_ENV=development
LOG_LEVEL=info

# ImageKit server-side credentials. Never expose the private key to Expo.
IMAGEKIT_PRIVATE_KEY=private_xxxxx
IMAGEKIT_PUBLIC_KEY=public_xxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id