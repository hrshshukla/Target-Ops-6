modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo development server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Local Vercel API"

[[workflows.workflow]]
name = "Expo development server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c './node_modules/.bin/expo start --web --host lan --port ${PORT:-5000}'"
waitForPort = 5000

[[workflows.workflow]]
name = "Local Vercel API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run api:dev"
waitForPort = 5000

[userenv]

[userenv.shared]
EXPO_PUBLIC_API_URL = "https://target-ops-6.vercel.app"
